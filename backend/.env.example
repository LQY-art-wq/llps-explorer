LLPS_APP_NAME=LLPS Explorer API
APP_ENV=development
# Development-only placeholder. Production rejects this value and requires 32+ random chars.
SESSION_SECRET=development-only-session-secret-do-not-deploy
PUBLIC_BASE_URL=http://127.0.0.1:3000
PUBLIC_HTTPS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false
RUN_MIGRATIONS_ON_STARTUP=true
# Persistent development database. A relative path resolves from the server working directory;
# production should use postgresql+psycopg://user:password@host/database.
DATABASE_URL=sqlite:///./backend/data/llps_explorer.db
ANALYSIS_RETENTION_DAYS=7
ANALYSIS_CLEANUP_INTERVAL_SECONDS=3600
# Ownership is enabled by default. This escape hatch is only for isolated local debugging.
DEV_DISABLE_JOB_OWNERSHIP=false
# Local development keeps the audited in-process adapters available.
LRECA_DEVICE=auto
LRECA_CLASSIFICATION_THRESHOLD=0.5
LRECA_TOP_RESIDUES=10
LRECA_KDE_PROMINENCE=0.1
LRECA_TORCH_THREADS=4
LRECA_WORKER_TIMEOUT_SECONDS=120
LRECA_STARTUP_TIMEOUT_SECONDS=120
# Defaults resolve against the project directory, independently of launch directory.
# Override these only when using the same audited source/checkpoint at another location.
# Example Linux/container overrides (server configuration, never returned by the API):
# LRECA_PYTHON=/opt/lreca-venv/bin/python
# LRECA_REPOSITORY=/opt/lreca-source
# LRECA_CHECKPOINT_PATH=/models/lreca/human_1_RCNN_ECA_parallel_089-0.9802.pt
# LRECA_CHECKPOINT remains a legacy alias; LRECA_CHECKPOINT_PATH takes precedence.

# Module 2: official FuzDrop automatic submission remains browser-protected.
# These settings only configure the official-site link and local result import.
FUZDROP_OFFICIAL_SITE_URL=https://fuzdrop.bio.unipd.it/predictor
FUZDROP_MANUAL_IMPORT_ENABLED=true
# Operational import byte limit; this is not a scientific sequence-length limit.
FUZDROP_IMPORT_MAX_BYTES=5242880

# Module 3: standard NCBI segmasker executable, resolved from PATH by default.
# Linux/Docker may set SEG_EXECUTABLE_PATH=/usr/bin/segmasker.
SEG_EXECUTABLE_PATH=segmasker
# Audited standard SEG defaults; server configuration only.
SEG_WINDOW=12
SEG_LOCUT=2.2
SEG_HICUT=2.5
SEG_TIMEOUT_SECONDS=10

# Module 4: DisMeta invocation and native result contracts remain unverified.
# This setting only supplies the official-site link; it cannot enable prediction or import.
DISMETA_OFFICIAL_SITE_URL=https://montelionelab.chem.rpi.edu/dismeta/

# Module 5: experimental weighted score; no probability calibration is implied.
ENSEMBLE_THRESHOLD=0.5
# Operational limits. Persisted sequence/import expiry uses ANALYSIS_RETENTION_DAYS.
ANALYSIS_METHOD_TIMEOUT_SECONDS=150
ANALYSIS_JOB_TIMEOUT_SECONDS=180
ANALYSIS_MAX_JOBS=128
ANALYSIS_MAX_CONCURRENT_JOBS=4
# Operational protection for submitted and imported sequences; supports 5000-aa analyses.
ANALYSIS_MAX_SEQUENCE_LENGTH=50000
EXTERNAL_RESULT_MAX_ENTRIES=128

# Module 10 durable execution. Keep in_process for ordinary Windows/local development.
ANALYSIS_QUEUE_BACKEND=in_process
# Production example: redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=analysis
ANALYSIS_QUEUE_MAX_JOBS=128
ANALYSIS_OWNER_ACTIVE_JOB_LIMIT=4
ANALYSIS_QUEUE_RETRY_MAX=2
ANALYSIS_QUEUE_RETRY_INTERVAL_SECONDS=10
ANALYSIS_QUEUE_TTL_SECONDS=3600
ANALYSIS_WORKER_RECOVERY_TIMEOUT_SECONDS=360
ANALYSIS_WORKER_MAINTENANCE_INTERVAL_SECONDS=30
# Production worker calls the private LRECA service instead of loading Torch itself.
# LRECA_SERVICE_URL=http://lreca:8100
LRECA_SERVICE_TIMEOUT_SECONDS=150
LRECA_SERVICE_CONNECT_TIMEOUT_SECONDS=5
LRECA_CHECKPOINT_SHA256=aa625942a726d24c15022f9486d0fc26e91ee0435ad554a8cd259825d8d7bbcc

# Production rate limits combine an anonymous-session key with a client-address key.
RATE_LIMIT_ANALYSIS_REQUESTS=10
RATE_LIMIT_IMPORT_REQUESTS=10
RATE_LIMIT_DELETE_REQUESTS=30
RATE_LIMIT_EXPORT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP_MULTIPLIER=4
