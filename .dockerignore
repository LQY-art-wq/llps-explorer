# Keep Docker build contexts limited to versioned source and configuration.
.git
.gitignore
.gitattributes
.github
.codex
.agents
.audit
.tools
.venv
.lreca-venv
.lreca-env

# Credentials and local configuration. Example files remain available.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
secrets
certs
certificates
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/acme.json

# The pinned upstream LRECA checkout is fetched at its audited commit while the
# LRECA image is built. Checkpoints are mounted read-only at runtime.
external/lreca
models
checkpoints
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.weights
**/*.onnx
**/*.h5
**/*.hdf5
**/*.pkl
**/*.pickle
**/*.bin

# Host dependencies, builds, caches, test evidence, and local databases.
**/node_modules
frontend/.next
frontend/out
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/.coverage
**/.coverage.*
**/htmlcov
**/coverage
**/coverage.xml
**/lcov.info
**/*.pyc
**/*.pyo
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
backend/data
docs/audit
build
dist

# User-created exports, backups, and temporary files never enter an image.
backups
exports
postgres-data
redis-data
appendonlydir
**/*.rdb
**/*.aof
uploads
user-data
runtime-data
**/*.dump
**/*.sql
**/*.sql.gz
tmp
temp
*.tmp
*.log
**/*.log
