# Local production-like Docker configuration. Copy to .env and replace every
# replace-* value with a new, URL-safe random value before starting the stack.
# Do not commit .env.

APP_ENV=production
LLPS_ENVIRONMENT=production
PUBLIC_BASE_URL=http://localhost
PUBLIC_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
RUN_MIGRATIONS_ON_STARTUP=false
HTTP_PORT=80

POSTGRES_USER=llps
POSTGRES_DB=llps_explorer
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://llps:replace-with-a-long-random-database-password@postgres:5432/llps_explorer

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0
ANALYSIS_QUEUE_BACKEND=rq
ANALYSIS_QUEUE_NAME=analysis
ANALYSIS_QUEUE_MAX_JOBS=128
ANALYSIS_OWNER_ACTIVE_JOB_LIMIT=4
ANALYSIS_QUEUE_RETRY_MAX=2
ANALYSIS_QUEUE_RETRY_INTERVAL_SECONDS=10
ANALYSIS_QUEUE_TTL_SECONDS=3600
ANALYSIS_WORKER_RECOVERY_TIMEOUT_SECONDS=360
ANALYSIS_WORKER_MAINTENANCE_INTERVAL_SECONDS=30

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ANALYSIS_RETENTION_DAYS=7
ANALYSIS_CLEANUP_INTERVAL_SECONDS=3600
ANALYSIS_MAX_SEQUENCE_LENGTH=50000
ANALYSIS_MAX_JOBS=128
ANALYSIS_MAX_CONCURRENT_JOBS=1
EXTERNAL_RESULT_MAX_ENTRIES=128

LRECA_SERVICE_URL=http://lreca:8001
LRECA_MODEL_DIR=./models/lreca
LRECA_CHECKPOINT_PATH=/models/lreca/human_1_RCNN_ECA_parallel_089-0.9802.pt
LRECA_CHECKPOINT_SHA256=aa625942a726d24c15022f9486d0fc26e91ee0435ad554a8cd259825d8d7bbcc
LRECA_DEVICE=cpu
LRECA_KDE_PROMINENCE=0.1
LRECA_TORCH_THREADS=4
LRECA_MAX_CONCURRENT_REQUESTS=1
LRECA_MODEL_PROCESSES=1
LRECA_SERVICE_TIMEOUT_SECONDS=150
LRECA_SERVICE_CONNECT_TIMEOUT_SECONDS=5

SEG_EXECUTABLE_PATH=/opt/ncbi-blast/bin/segmasker
SEG_WINDOW=12
SEG_LOCUT=2.2
SEG_HICUT=2.5
SEG_TIMEOUT_SECONDS=10
ENSEMBLE_THRESHOLD=0.5

RATE_LIMIT_ANALYSIS_REQUESTS=10
RATE_LIMIT_IMPORT_REQUESTS=10
RATE_LIMIT_DELETE_REQUESTS=30
RATE_LIMIT_EXPORT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP_MULTIPLIER=4
TRUST_PROXY_HEADERS=true

BACKEND_WEB_WORKERS=1
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
LRECA_CPU_LIMIT=4.0
LRECA_MEMORY_LIMIT=8G
