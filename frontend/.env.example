# Required, server-only target for the same-origin /api proxy.
# Local example below; a future container may use http://backend:8000.
# The browser never receives this value. Do not prefix it with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
# Optional local acceptance harness only. Keep disabled in ordinary deployments.
# Enables the /dev/feature-viewer and /dev/sequence-viewer synthetic acceptance harnesses.
FEATURE_VIEWER_TEST_MODE=0
